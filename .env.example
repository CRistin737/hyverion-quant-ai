APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///data/trading_bot.db

# Hyverion trades QQQ only. Other symbols are observation-only sensors.
PRIMARY_INSTRUMENT=QQQ
TRADING_MODE=paper
LIVE_TRADING=false
SHADOW_TRADING=true
OPERATING_REGION=US

# simulator = internal paper fills; alpaca = your Alpaca PAPER account.
BROKER_PROVIDER=simulator
BROKER_ENV=paper
# Alpaca PAPER keys (app.alpaca.markets > Paper Trading > API Keys).
# Prefer the macOS Keychain from the app; never commit real values.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_FEED=iex

BASE_RISK_PERCENT=0.25
MAX_BASE_RISK_USD=10
DAILY_PROFIT_SOFT_MIN_USD=10
DAILY_PROFIT_HARD_CAP_USD=50
DAILY_LOSS_LIMIT_USD=
WEEKLY_LOSS_LIMIT_USD=
MAX_PROFIT_GIVEBACK_PERCENT=35
MAX_TRADES_PER_DAY=3

AI_PRIMARY_PROVIDER=disabled
AI_PRIMARY_AUTH_MODE=subscription
AI_PRIMARY_MODEL_PROFILE=STANDARD
AI_FALLBACK_PROVIDERS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
MAX_AI_COST_DAILY_USD=2

NEWS_PROVIDER=disabled
NEWS_API_KEY=
SOCIAL_PROVIDER=disabled
X_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
CONTROL_API_TOKEN=

AUTO_PROMOTE_AGENT_CHANGES=false

# Memory backend (Docker profile `memory`). Generate local random values; never commit .env.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MEMORY_WORKING_BACKEND=in_process
REDIS_URL=
HYVERION_TEST_POSTGRES_URL=
